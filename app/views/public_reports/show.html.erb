<div class="max-w-4xl mx-auto py-12 px-6">
  <!-- Header -->
  <header class="flex justify-between items-center mb-12 pb-6 border-b">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-bold">G</div>
      <span class="font-bold tracking-tight">Growth Machine</span>
    </div>
    <div class="text-right">
      <div class="text-xs font-bold text-slate-400 uppercase tracking-widest">Relatorio Publico</div>
      <div class="text-sm text-slate-500"><%= Time.current.strftime("%d/%m/%Y") %></div>
    </div>
  </header>

  <!-- Report Content -->
  <article class="glass p-10 md:p-16 rounded-[3rem] shadow-2xl relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-400/10 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-2 text-slate-900"><%= @report.title %></h1>
      <p class="text-xl text-blue-600 font-medium mb-12"><%= @report.client.business_name %></p>

      <div class="prose prose-slate max-w-none">
        <%= simple_format(@report.content, class: "text-lg leading-relaxed text-slate-700 space-y-6") %>
      </div>

      <div class="mt-20 pt-10 border-t border-slate-200">
        <div class="flex flex-col md:flex-row justify-between items-center gap-8">
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Gostou desse piloto?</h4>
            <p class="text-slate-500 text-sm">Contrate o plano mensal para ter conteudo novo toda semana.</p>
          </div>
          <a href="/#precos" class="px-8 py-4 rounded-full btn-primary font-bold shadow-lg shadow-blue-500/20">Ver Planos Pro</a>
        </div>
      </div>
    </div>
  </article>

  <footer class="mt-12 text-center">
    <p class="text-xs text-slate-400">&copy; <%= Time.current.year %> Growth Machine — Conteudo automatizado para negocios locais.</p>
  </footer>
</div>
