<div class="max-w-5xl mx-auto py-20 px-6 reveal">
  <!-- Header -->
  <header class="flex justify-between items-center mb-16 pb-8 border-b border-slate-100">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-slate-900 text-white rounded-[14px] flex items-center justify-center text-xl font-extrabold shadow-xl shadow-slate-900/10 transition-transform hover:scale-105">G</div>
      <span class="text-xl font-extrabold tracking-tighter text-slate-900">Growth Machine</span>
    </div>
    <div class="text-right">
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-1">Relatório Público</div>
      <div class="text-sm text-slate-500 font-bold uppercase tracking-widest tabular-nums"><%= Time.current.strftime("%d de %B, %Y") %></div>
    </div>
  </header>

  <!-- Report Content -->
  <article class="glass p-12 md:p-20 rounded-[64px] shadow-[0_40px_100px_-20px_oklch(0%_0_0_/_0.08)] border-white/60 relative overflow-hidden">
    <!-- Decorative Bloom -->
    <div class="absolute -top-20 -right-20 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-purple-500/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10">
      <h1 class="text-5xl md:text-7xl font-extrabold mb-4 text-slate-900 tracking-tighter leading-[1.1]"><%= @report.title %></h1>
      <p class="text-2xl text-blue-600 font-bold italic mb-16 tracking-tight"><%= @report.client.business_name %></p>

      <div class="prose prose-slate max-w-none prose-p:text-xl prose-p:leading-relaxed prose-p:text-slate-600 prose-p:font-medium prose-strong:text-slate-900 prose-headings:text-slate-900 prose-headings:font-extrabold prose-headings:tracking-tight space-y-10">
        <%= simple_format(@report.content) %>
      </div>

      <div class="mt-32 pt-12 border-t border-slate-100">
        <div class="flex flex-col md:flex-row justify-between items-center gap-12 glass p-10 rounded-[40px] border-white/40">
          <div>
            <h4 class="text-2xl font-extrabold text-slate-900 mb-2 tracking-tight">Gostou desse piloto?</h4>
            <p class="text-slate-500 text-lg font-medium leading-relaxed">Contrate o plano mensal para ter conteúdo novo e estratégico toda semana.</p>
          </div>
          <a href="/#precos" class="px-10 py-5 rounded-full btn-primary text-xl font-bold shadow-2xl shadow-blue-500/20 whitespace-nowrap">Ver Planos Pro</a>
        </div>
      </div>
    </div>
  </article>

  <footer class="mt-16 text-center">
    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em]">&copy; <%= Time.current.year %> Growth Machine — Conteúdo automatizado para negócios locais.</p>
  </footer>
</div>
