<div class="min-h-screen bg-gray-50 py-12 px-6">
  <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-sm p-8">
    <div class="border-b pb-4 mb-6">
      <h1 class="text-2xl font-bold text-gray-800"><%= @report.title %></h1>
      <p class="text-gray-500 text-sm mt-1">
        <%= @report.client.business_name %> &mdash; <%= @report.created_at.strftime("%d/%m/%Y") %>
      </p>
    </div>
    <div class="prose max-w-none">
      <%= simple_format(@report.content) %>
    </div>
  </div>
</div>
