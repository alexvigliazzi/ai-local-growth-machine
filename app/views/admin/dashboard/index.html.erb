<h1 class="text-2xl font-bold mb-8">Dashboard</h1>

<!-- KPIs -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white p-6 rounded-lg shadow-sm">
    <p class="text-gray-500 text-sm">Leads</p>
    <p class="text-3xl font-bold"><%= @leads_count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow-sm">
    <p class="text-gray-500 text-sm">Clientes</p>
    <p class="text-3xl font-bold"><%= @clients_count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow-sm">
    <p class="text-gray-500 text-sm">Pedidos Pendentes</p>
    <p class="text-3xl font-bold"><%= @pending_requests %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow-sm">
    <p class="text-gray-500 text-sm">Conteudos Gerados</p>
    <p class="text-3xl font-bold"><%= @outputs_count %></p>
  </div>
</div>

<!-- Recent Leads -->
<div class="bg-white rounded-lg shadow-sm p-6">
  <h2 class="text-lg font-semibold mb-4">Leads Recentes</h2>
  <% if @recent_leads.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-gray-500 border-b">
          <th class="pb-2">Negocio</th>
          <th class="pb-2">Nicho</th>
          <th class="pb-2">Cidade</th>
          <th class="pb-2">Status</th>
          <th class="pb-2">Data</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_leads.each do |lead| %>
          <tr class="border-b last:border-0">
            <td class="py-2"><%= link_to lead.business_name, admin_lead_path(lead), class: "text-blue-600 hover:underline" %></td>
            <td class="py-2"><%= lead.niche %></td>
            <td class="py-2"><%= lead.city %></td>
            <td class="py-2">
              <span class="px-2 py-1 rounded-full text-xs font-medium
                <%= case lead.status
                    when 'new' then 'bg-blue-100 text-blue-700'
                    when 'contacted' then 'bg-yellow-100 text-yellow-700'
                    when 'converted' then 'bg-green-100 text-green-700'
                    when 'lost' then 'bg-red-100 text-red-700'
                    else 'bg-gray-100 text-gray-700'
                    end %>">
                <%= lead.status %>
              </span>
            </td>
            <td class="py-2 text-gray-500"><%= lead.created_at.strftime("%d/%m") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">Nenhum lead ainda. <%= link_to "Ver landing page", root_path, class: "text-blue-600" %>.</p>
  <% end %>
</div>
