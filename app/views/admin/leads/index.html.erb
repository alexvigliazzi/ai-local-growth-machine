<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Leads</h1>
  <span class="text-gray-500"><%= @leads.count %> total</span>
</div>

<div class="bg-white rounded-lg shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-gray-500 border-b bg-gray-50">
        <th class="p-3">Negocio</th>
        <th class="p-3">Nicho</th>
        <th class="p-3">Cidade</th>
        <th class="p-3">WhatsApp</th>
        <th class="p-3">Status</th>
        <th class="p-3">Data</th>
      </tr>
    </thead>
    <tbody>
      <% @leads.each do |lead| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3"><%= link_to lead.business_name, admin_lead_path(lead), class: "text-blue-600 hover:underline" %></td>
          <td class="p-3"><%= lead.niche %></td>
          <td class="p-3"><%= lead.city %></td>
          <td class="p-3"><%= lead.whatsapp %></td>
          <td class="p-3">
            <span class="px-2 py-1 rounded-full text-xs font-medium
              <%= case lead.status
                  when 'new' then 'bg-blue-100 text-blue-700'
                  when 'contacted' then 'bg-yellow-100 text-yellow-700'
                  when 'converted' then 'bg-green-100 text-green-700'
                  when 'lost' then 'bg-red-100 text-red-700'
                  else 'bg-gray-100 text-gray-700'
                  end %>">
              <%= lead.status %>
            </span>
          </td>
          <td class="p-3 text-gray-500"><%= lead.created_at.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
