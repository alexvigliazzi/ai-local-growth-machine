<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Leads</h1>
  <div class="flex gap-4">
    <div class="relative">
      <input type="text" placeholder="Buscar leads..." class="pl-10 pr-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm outline-none focus:ring-4 focus:ring-blue-500/10 transition-all">
      <svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
    </div>
  </div>
</div>

<div class="admin-card overflow-hidden shadow-2xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-white/[0.02] text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">
          <th class="px-8 py-5">Negocio</th>
          <th class="px-8 py-5">Cidade</th>
          <th class="px-8 py-5">Nicho</th>
          <th class="px-8 py-5">Status</th>
          <th class="px-8 py-5">Origem</th>
          <th class="px-8 py-5 text-right">Acoes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-white/[0.03] transition-colors group">
            <td class="px-8 py-6">
              <div class="font-bold text-white text-base group-hover:text-blue-400 transition-colors"><%= lead.business_name %></div>
              <div class="text-xs text-slate-500 font-medium"><%= lead.whatsapp %></div>
            </td>
            <td class="px-8 py-6 text-sm text-slate-400 font-medium"><%= lead.city %></td>
            <td class="px-8 py-6">
              <span class="text-[10px] px-2 py-1 bg-white/5 border border-white/10 rounded-md text-slate-400 font-bold uppercase tracking-widest"><%= lead.niche&.humanize %></span>
            </td>
            <td class="px-8 py-6">
              <% case lead.status %>
              <% when 'new' %>
                <span class="px-3 py-1.5 rounded-lg bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-blue-500/20">Novo</span>
              <% when 'contacted' %>
                <span class="px-3 py-1.5 rounded-lg bg-yellow-500/10 text-yellow-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-yellow-500/20">Contatado</span>
              <% when 'converted' %>
                <span class="px-3 py-1.5 rounded-lg bg-green-500/10 text-green-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-green-500/20">Convertido</span>
              <% when 'lost' %>
                <span class="px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-red-500/20">Perdido</span>
              <% end %>
            </td>
            <td class="px-8 py-6 text-xs text-slate-500 font-bold uppercase tracking-widest">Site</td>
            <td class="px-8 py-6 text-right space-x-3">
              <%= link_to "Ver", admin_lead_path(lead), class: "text-blue-400 font-bold text-xs hover:text-blue-300 transition-colors" %>
              <%= link_to "Editar", edit_admin_lead_path(lead), class: "text-slate-500 font-bold text-xs hover:text-white transition-colors" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
