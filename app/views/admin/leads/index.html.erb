<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-slate-900">Leads</h1>
  <div class="flex gap-4">
    <div class="relative">
      <input type="text" placeholder="Buscar leads..." class="pl-10 pr-4 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-blue-500/20">
      <svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
    </div>
  </div>
</div>

<div class="admin-card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-slate-50 text-slate-400 text-[10px] uppercase tracking-widest font-bold">
          <th class="px-6 py-4">Negocio</th>
          <th class="px-6 py-4">Cidade</th>
          <th class="px-6 py-4">Nicho</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Origem</th>
          <th class="px-6 py-4 text-right">Acoes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-bold text-slate-900 text-sm"><%= lead.business_name %></div>
              <div class="text-xs text-slate-500"><%= lead.whatsapp %></div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-600"><%= lead.city %></td>
            <td class="px-6 py-4">
              <span class="text-xs px-2 py-0.5 bg-slate-100 rounded text-slate-600 font-medium"><%= lead.niche&.humanize %></span>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider
                <%= case lead.status
                    when 'new' then 'bg-blue-100 text-blue-700'
                    when 'contacted' then 'bg-yellow-100 text-yellow-700'
                    when 'converted' then 'bg-green-100 text-green-700'
                    else 'bg-red-100 text-red-700'
                    end %>">
                <%= lead.status&.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 text-xs text-slate-400">Site</td>
            <td class="px-6 py-4 text-right">
              <%= link_to "Ver", admin_lead_path(lead), class: "text-blue-600 font-bold text-xs hover:underline" %>
              <span class="mx-2 text-slate-300">|</span>
              <%= link_to "Editar", edit_admin_lead_path(lead), class: "text-slate-400 font-bold text-xs hover:text-slate-600" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
