<div class="mb-12 flex items-center gap-6">
  <%= link_to admin_leads_path, class: "p-3 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <div>
    <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Lead: <%= @lead.business_name %></h1>
    <p class="text-slate-500 font-medium">Detalhes e ações para este lead.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
  <div class="lg:col-span-2 space-y-10">
    <div class="admin-card p-10">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-4">Informações do Negócio</h3>
      <div class="grid grid-cols-2 gap-y-8">
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Nome</label>
          <p class="text-lg font-bold text-white tracking-tight"><%= @lead.business_name %></p>
        </div>
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Nicho</label>
          <p class="text-base font-medium text-slate-300"><%= @lead.niche&.humanize %></p>
        </div>
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Cidade</label>
          <p class="text-base font-medium text-slate-300"><%= @lead.city %></p>
        </div>
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Status Atual</label>
          <div>
            <% case @lead.status %>
            <% when 'new' %>
              <span class="px-3 py-1.5 rounded-lg bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-blue-500/20">Novo</span>
            <% when 'contacted' %>
              <span class="px-3 py-1.5 rounded-lg bg-yellow-500/10 text-yellow-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-yellow-500/20">Contatado</span>
            <% when 'converted' %>
              <span class="px-3 py-1.5 rounded-lg bg-green-500/10 text-green-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-green-500/20">Convertido</span>
            <% when 'lost' %>
              <span class="px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-red-500/20">Perdido</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-card p-10">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-4">Dados de Contato</h3>
      <div class="space-y-6">
        <div class="flex items-center gap-6 p-6 bg-white/5 border border-white/10 rounded-2xl group hover:bg-white/[0.08] transition-all">
          <div class="w-14 h-14 bg-green-500/20 rounded-xl flex items-center justify-center text-green-500 border border-green-500/20">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">WhatsApp</div>
            <div class="text-xl font-extrabold text-white tabular-nums tracking-tighter"><%= @lead.whatsapp %></div>
          </div>
          <% if @lead.whatsapp.present? %>
            <%= link_to "Abrir Chat", "https://wa.me/#{@lead.whatsapp.gsub(/\D/, '')}", target: "_blank", class: "ml-auto px-6 py-3 bg-green-500 text-white text-xs font-bold rounded-xl hover:bg-green-400 transition-colors shadow-lg shadow-green-500/20" %>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">E-mail</div>
            <div class="text-base font-bold text-white"><%= @lead.email %></div>
          </div>
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Instagram</div>
            <div class="text-base font-bold text-white"><%= @lead.instagram_url %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-10">
    <div class="admin-card p-8">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Ações Rápidas</h3>
      <div class="grid grid-cols-1 gap-3">
        <%= link_to "Editar Lead", edit_admin_lead_path(@lead), class: "w-full py-4 bg-blue-600 text-white text-center font-bold rounded-xl shadow-xl shadow-blue-500/20 hover:bg-blue-500 transition-colors" %>
        <%= link_to "Voltar", admin_leads_path, class: "w-full py-4 bg-white/5 border border-white/10 text-slate-300 text-center font-bold rounded-xl hover:bg-white/10 transition-colors" %>
      </div>
    </div>

    <div class="admin-card p-8">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Automação</h3>
      <%= form_with url: queue_outreach_admin_lead_path(@lead), method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-2">Canal</label>
          <div class="relative">
            <%= f.select :channel,
                [["WhatsApp", "whatsapp"], ["E-mail", "email"], ["Instagram DM", "instagram_dm"]],
                {},
                class: "w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:ring-4 focus:ring-blue-500/10 transition-all appearance-none" %>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-30">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
          </div>
        </div>
        <div>
          <label class="block text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-2">Tipo</label>
          <div class="relative">
            <%= f.select :message_type,
                [["Primeiro Contato", "primeiro_contato"], ["Follow-up", "follow_up"], ["Proposta", "proposta"]],
                {},
                class: "w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:ring-4 focus:ring-blue-500/10 transition-all appearance-none" %>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-30">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
          </div>
        </div>
        <%= f.button type: :submit, class: "w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-3 shadow-xl shadow-indigo-500/20" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Gerar Mensagem
        <% end %>
      <% end %>
    </div>

    <div class="admin-card p-8">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Notas</h3>
      <div class="text-sm text-slate-400 leading-relaxed bg-white/5 p-6 rounded-2xl border border-white/10">
        <%= @lead.notes.presence || "Nenhuma nota registrada." %>
      </div>
    </div>
  </div>
</div>
