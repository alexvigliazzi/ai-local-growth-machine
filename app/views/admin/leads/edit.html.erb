<h1 class="text-2xl font-bold mb-6">Editar Lead</h1>

<div class="bg-white rounded-lg shadow-sm p-6">
  <%= form_with model: [:admin, @lead], class: "space-y-4" do |f| %>
    <% if @lead.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">
        <ul class="list-disc list-inside">
          <% @lead.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nome do negocio</label>
        <%= f.text_field :business_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <%= f.select :status, %w[new contacted qualified proposal_sent converted lost], {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
        <%= f.text_field :whatsapp, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <%= f.text_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
      <%= f.text_area :notes, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Salvar", class: "bg-blue-700 text-white px-6 py-2 rounded-lg hover:bg-blue-600 cursor-pointer" %>
      <%= link_to "Cancelar", admin_lead_path(@lead), class: "px-6 py-2 text-gray-600 hover:text-gray-800" %>
    </div>
  <% end %>
</div>
