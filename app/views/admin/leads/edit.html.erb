<div class="mb-12 flex items-center gap-6">
  <%= link_to admin_lead_path(@lead), class: "p-3 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <div>
    <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Editar Lead: <%= @lead.business_name %></h1>
    <p class="text-slate-500 font-medium">Atualize as informações internas do lead.</p>
  </div>
</div>

<div class="max-w-3xl">
  <div class="admin-card p-10 shadow-2xl">
    <%= form_with model: [:admin, @lead] do |f| %>
      <div class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="group">
            <%= f.label :business_name, "Nome do negócio", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-400 transition-colors" %>
            <%= f.text_field :business_name, class: "w-full p-4 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:ring-4 focus:ring-blue-500/10 outline-none transition-all" %>
          </div>
          <div class="group">
            <%= f.label :status, "Status", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-400 transition-colors" %>
            <div class="relative">
              <%= f.select :status,
                  options_for_select([['Novo', 'new'], ['Contatado', 'contacted'], ['Convertido', 'converted'], ['Perdido', 'lost']], @lead.status),
                  {},
                  class: "w-full p-4 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:ring-4 focus:ring-blue-500/10 outline-none transition-all appearance-none" %>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>
        </div>

        <div class="group">
          <%= f.label :notes, "Notas internas", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-400 transition-colors" %>
          <%= f.text_area :notes, rows: 6, class: "w-full p-5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:ring-4 focus:ring-blue-500/10 outline-none transition-all resize-none leading-relaxed" %>
        </div>

        <div class="pt-6 flex gap-4 border-t border-white/5">
          <%= f.submit "Salvar alterações", class: "px-10 py-4 bg-blue-600 text-white font-bold rounded-xl shadow-xl shadow-blue-500/20 hover:bg-blue-500 transition-all cursor-pointer" %>
          <%= link_to "Cancelar", admin_lead_path(@lead), class: "px-10 py-4 bg-white/5 border border-white/10 text-slate-300 font-bold rounded-xl hover:bg-white/10 transition-all" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
