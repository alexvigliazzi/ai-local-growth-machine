<div class="mb-8 flex items-center gap-4">
  <%= link_to admin_lead_path(@lead), class: "p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <h1 class="text-2xl font-bold text-slate-900">Editar Lead: <%= @lead.business_name %></h1>
</div>

<div class="max-w-2xl">
  <div class="admin-card p-8">
    <%= form_with model: [:admin, @lead] do |f| %>
      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-6">
          <div>
            <%= f.label :business_name, "Nome do negocio", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
            <%= f.text_field :business_name, class: "w-full p-3 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 outline-none" %>
          </div>
          <div>
            <%= f.label :status, "Status", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
            <%= f.select :status,
                options_for_select([['Novo', 'new'], ['Contatado', 'contacted'], ['Convertido', 'converted'], ['Perdido', 'lost']], @lead.status),
                {},
                class: "w-full p-3 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 outline-none appearance-none bg-slate-50" %>
          </div>
        </div>

        <div>
          <%= f.label :notes, "Notas internas", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
          <%= f.text_area :notes, rows: 5, class: "w-full p-3 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 outline-none" %>
        </div>

        <div class="pt-4 flex gap-4">
          <%= f.submit "Salvar alteracoes", class: "px-8 py-3 bg-slate-900 text-white font-bold rounded-lg cursor-pointer" %>
          <%= link_to "Cancelar", admin_lead_path(@lead), class: "px-8 py-3 border border-slate-200 text-slate-600 font-bold rounded-lg" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
