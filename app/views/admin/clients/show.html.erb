<h1 class="text-2xl font-bold mb-6"><%= @client.business_name %></h1>

<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <div class="grid md:grid-cols-3 gap-4">
    <div><p class="text-gray-500 text-sm">Nicho</p><p class="font-medium"><%= @client.niche %></p></div>
    <div><p class="text-gray-500 text-sm">Cidade</p><p class="font-medium"><%= @client.city %></p></div>
    <div><p class="text-gray-500 text-sm">Plano</p><p class="font-medium"><%= @client.plan || "—" %></p></div>
    <div><p class="text-gray-500 text-sm">Contato</p><p class="font-medium"><%= @client.contact_name || "—" %></p></div>
    <div><p class="text-gray-500 text-sm">WhatsApp</p><p class="font-medium"><%= @client.whatsapp || "—" %></p></div>
    <div><p class="text-gray-500 text-sm">Email</p><p class="font-medium"><%= @client.email || "—" %></p></div>
  </div>
</div>

<h2 class="text-lg font-semibold mb-4">Pedidos de Conteudo</h2>
<% @content_requests.each do |cr| %>
  <div class="bg-white rounded-lg shadow-sm p-4 mb-3">
    <div class="flex justify-between">
      <span class="font-medium"><%= cr.objective&.truncate(80) || "Sem objetivo" %></span>
      <span class="px-2 py-1 rounded-full text-xs font-medium bg-gray-100"><%= cr.status %></span>
    </div>
    <% if cr.content_outputs.any? %>
      <div class="mt-2 space-y-1">
        <% cr.content_outputs.each do |co| %>
          <div class="text-sm text-gray-600">
            <%= link_to co.title, admin_content_output_path(co), class: "text-blue-600 hover:underline" %>
            <span class="text-gray-400">(<%= co.output_type %> / <%= co.status %>)</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to "&larr; Voltar".html_safe, admin_clients_path, class: "inline-block mt-4 text-gray-600 hover:text-gray-800" %>
