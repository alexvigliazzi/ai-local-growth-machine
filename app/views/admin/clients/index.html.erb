<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Clientes</h1>
  <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest bg-white/5 px-4 py-2 rounded-full border border-white/10">
    Total: <%= @clients.count %>
  </div>
</div>

<div class="admin-card overflow-hidden shadow-2xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-white/[0.02] text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">
          <th class="px-8 py-5">Negocio</th>
          <th class="px-8 py-5">Contato</th>
          <th class="px-8 py-5">Plano</th>
          <th class="px-8 py-5">Status</th>
          <th class="px-8 py-5 text-right">Acoes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% @clients.each do |client| %>
          <tr class="hover:bg-white/[0.03] transition-colors group">
            <td class="px-8 py-6">
              <div class="font-bold text-white text-base group-hover:text-blue-400 transition-colors"><%= client.business_name %></div>
              <div class="text-xs text-slate-500 font-medium"><%= client.city %></div>
            </td>
            <td class="px-8 py-6 text-sm text-slate-400 font-medium"><%= client.contact_name %></td>
            <td class="px-8 py-6">
              <span class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-[0.15em] border
                <%= client.plan == 'pro' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 'bg-blue-500/10 text-blue-400 border-blue-500/20' %>">
                <%= client.plan&.humanize %>
              </span>
            </td>
            <td class="px-8 py-6">
              <span class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                Ativo
              </span>
            </td>
            <td class="px-8 py-6 text-right">
              <%= link_to "Gerenciar", admin_client_path(client), class: "text-blue-400 font-bold text-xs hover:text-blue-300 transition-colors" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
