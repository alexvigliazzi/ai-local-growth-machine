<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-slate-900">Clientes</h1>
</div>

<div class="admin-card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-slate-50 text-slate-400 text-[10px] uppercase tracking-widest font-bold">
          <th class="px-6 py-4">Negocio</th>
          <th class="px-6 py-4">Contato</th>
          <th class="px-6 py-4">Plano</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Acoes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @clients.each do |client| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-bold text-slate-900 text-sm"><%= client.business_name %></div>
              <div class="text-xs text-slate-500"><%= client.city %></div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-600"><%= client.contact_name %></td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest <%= client.plan == 'pro' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                <%= client.plan&.humanize %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                Ativo
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to "Gerenciar", admin_client_path(client), class: "text-blue-600 font-bold text-xs hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
