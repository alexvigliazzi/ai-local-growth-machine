<h1 class="text-2xl font-bold mb-6">Clientes</h1>

<div class="bg-white rounded-lg shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-gray-500 border-b bg-gray-50">
        <th class="p-3">Negocio</th>
        <th class="p-3">Nicho</th>
        <th class="p-3">Plano</th>
        <th class="p-3">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @clients.each do |client| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3"><%= link_to client.business_name, admin_client_path(client), class: "text-blue-600 hover:underline" %></td>
          <td class="p-3"><%= client.niche %></td>
          <td class="p-3"><%= client.plan || "—" %></td>
          <td class="p-3"><%= client.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
