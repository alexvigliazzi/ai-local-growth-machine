<div class="mb-8 flex items-center gap-4">
  <%= link_to admin_content_outputs_path, class: "p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <h1 class="text-2xl font-bold text-slate-900">Editar Conteudo</h1>
</div>

<div class="max-w-4xl">
  <div class="admin-card p-8">
    <%= form_with model: [:admin, @content_output] do |f| %>
      <div class="space-y-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Cliente / Pedido</label>
          <p class="text-sm font-bold text-slate-900"><%= @content_output.content_request.client.business_name %> — <%= @content_output.content_request.objective.truncate(60) %></p>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div>
            <%= f.label :title, "Titulo do Conteudo", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
            <%= f.text_field :title, class: "w-full p-3 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 outline-none" %>
          </div>
          <div>
            <%= f.label :status, "Status", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
            <%= f.select :status,
                options_for_select([['Rascunho', 'draft'], ['Em Revisao', 'review'], ['Aprovado', 'approved']], @content_output.status),
                {},
                class: "w-full p-3 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 outline-none appearance-none bg-slate-50" %>
          </div>
        </div>

        <div>
          <%= f.label :content, "Texto do Conteudo", class: "block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2" %>
          <%= f.text_area :content, rows: 12, class: "w-full p-4 rounded-xl border border-slate-200 text-sm font-mono leading-relaxed focus:ring-2 focus:ring-blue-500/20 outline-none" %>
        </div>

        <div class="pt-4 flex gap-4">
          <%= f.submit "Salvar Conteudo", class: "px-8 py-3 bg-slate-900 text-white font-bold rounded-lg cursor-pointer" %>
          <%= link_to "Cancelar", admin_content_outputs_path, class: "px-8 py-3 border border-slate-200 text-slate-600 font-bold rounded-lg" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
