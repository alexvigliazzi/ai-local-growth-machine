<h1 class="text-2xl font-bold mb-6">Editar Conteudo</h1>
<div class="bg-white rounded-lg shadow-sm p-6">
  <%= form_with model: [:admin, @content_output], class: "space-y-4" do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Titulo</label>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
        <%= f.select :output_type, %w[video_script social_post content_plan], {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <%= f.select :status, %w[draft review approved], {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Conteudo</label>
      <%= f.text_area :content, rows: 15, class: "w-full border border-gray-300 rounded-lg px-3 py-2 font-mono text-sm" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Salvar", class: "bg-blue-700 text-white px-6 py-2 rounded-lg hover:bg-blue-600 cursor-pointer" %>
      <%= link_to "Cancelar", admin_content_output_path(@content_output), class: "px-6 py-2 text-gray-600" %>
    </div>
  <% end %>
</div>
