<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold"><%= @content_output.title %></h1>
  <%= link_to "Editar", edit_admin_content_output_path(@content_output), class: "bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-600 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow-sm p-6">
  <div class="flex gap-4 mb-4 text-sm text-gray-500">
    <span>Tipo: <strong><%= @content_output.output_type %></strong></span>
    <span>Status: <strong><%= @content_output.status %></strong></span>
  </div>
  <div class="prose max-w-none">
    <%= simple_format(@content_output.content) %>
  </div>
</div>

<%= link_to "&larr; Voltar".html_safe, admin_content_outputs_path, class: "inline-block mt-4 text-gray-600 hover:text-gray-800" %>
