<div class="mb-12 flex items-center gap-6">
  <%= link_to admin_reports_path, class: "p-3 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <div>
    <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Relatório Executivo</h1>
    <p class="text-slate-500 font-medium">Visualize e compartilhe o relatório com o cliente.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
  <div class="lg:col-span-2 space-y-10">
    <div class="admin-card p-10 shadow-2xl">
      <div class="flex justify-between items-center mb-10 border-b border-white/5 pb-6">
        <h2 class="text-2xl font-extrabold text-white tracking-tight"><%= @report.title %></h2>
        <div class="text-right">
          <div class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-2">Token Público</div>
          <code class="text-xs bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg text-blue-400 font-mono"><%= @report.token %></code>
        </div>
      </div>

      <div class="prose prose-invert max-w-none prose-p:text-slate-300 prose-headings:text-white prose-strong:text-white prose-a:text-blue-400 leading-relaxed">
        <%= simple_format(@report.content) %>
      </div>
    </div>
  </div>

  <div class="space-y-10">
    <div class="admin-card p-8">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Ações</h3>
      <div class="grid grid-cols-1 gap-3">
        <%= link_to "/r/#{@report.token}", target: "_blank", class: "w-full py-4 bg-blue-600 text-white text-center font-bold rounded-xl shadow-xl shadow-blue-500/20 hover:bg-blue-500 transition-all flex items-center justify-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          Visualizar Como Cliente
        <% end %>
      </div>
    </div>

    <div class="admin-card p-8 group">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Proprietário</h3>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-white/5 rounded-2xl flex items-center justify-center text-slate-400 font-extrabold text-xl border border-white/10 group-hover:scale-110 transition-transform">
          <%= @report.client.business_name[0] %>
        </div>
        <div>
          <div class="text-base font-bold text-white tracking-tight"><%= @report.client.business_name %></div>
          <%= link_to "Ver Perfil do Cliente", admin_client_path(@report.client), class: "text-xs text-blue-400 font-bold hover:text-blue-300 transition-colors" %>
        </div>
      </div>
    </div>
  </div>
</div>
