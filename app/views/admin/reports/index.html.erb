<h1 class="text-2xl font-bold mb-6">Relatorios</h1>
<div class="bg-white rounded-lg shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-gray-500 border-b bg-gray-50">
        <th class="p-3">Titulo</th>
        <th class="p-3">Cliente</th>
        <th class="p-3">Link Publico</th>
        <th class="p-3">Data</th>
      </tr>
    </thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3"><%= link_to report.title, admin_report_path(report), class: "text-blue-600 hover:underline" %></td>
          <td class="p-3"><%= report.client.business_name %></td>
          <td class="p-3"><%= link_to "/r/#{report.token}", public_report_path(report.token), class: "text-blue-600 hover:underline", target: "_blank" %></td>
          <td class="p-3 text-gray-500"><%= report.created_at.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
