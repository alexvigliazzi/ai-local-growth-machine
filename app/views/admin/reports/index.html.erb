<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-slate-900">Relatorios Executivos</h1>
</div>

<div class="admin-card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-slate-50 text-slate-400 text-[10px] uppercase tracking-widest font-bold">
          <th class="px-6 py-4">Titulo</th>
          <th class="px-6 py-4">Cliente</th>
          <th class="px-6 py-4">URL Publica</th>
          <th class="px-6 py-4 text-right">Criado em</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @reports.each do |report| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4 font-bold text-slate-900 text-sm"><%= report.title %></td>
            <td class="px-6 py-4 text-sm text-slate-600"><%= report.client.business_name %></td>
            <td class="px-6 py-4">
              <%= link_to "/r/#{report.token}", "/r/#{report.token}", target: "_blank", class: "text-blue-600 text-xs hover:underline" %>
            </td>
            <td class="px-6 py-4 text-right text-xs text-slate-400">
              <%= report.created_at.strftime("%d/%m/%y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
