<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Pedidos de Conteúdo</h1>
  <div class="flex gap-3">
    <span class="px-4 py-2 bg-orange-500/10 text-orange-400 rounded-full text-[10px] font-bold uppercase tracking-widest border border-orange-500/20 shadow-lg shadow-orange-500/10">
      <%= @pending_requests %> Pendentes
    </span>
  </div>
</div>

<div class="admin-card overflow-hidden shadow-2xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-white/[0.02] text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">
          <th class="px-8 py-5">Cliente</th>
          <th class="px-8 py-5">Objetivo</th>
          <th class="px-8 py-5">Tom</th>
          <th class="px-8 py-5">Status</th>
          <th class="px-8 py-5 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% @content_requests.each do |request| %>
          <tr class="hover:bg-white/[0.03] transition-colors group">
            <td class="px-8 py-6">
              <div class="font-bold text-white text-base group-hover:text-blue-400 transition-colors"><%= request.client.business_name %></div>
              <div class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1"><%= request.created_at.strftime("%d/%m/%y") %></div>
            </td>
            <td class="px-8 py-6">
              <div class="text-sm text-slate-400 truncate max-w-xs font-medium"><%= request.objective %></div>
            </td>
            <td class="px-8 py-6 text-xs text-slate-500 font-bold uppercase tracking-widest"><%= request.tone&.humanize %></td>
            <td class="px-8 py-6">
              <% case request.status %>
              <% when 'pending' %>
                <span class="px-3 py-1.5 rounded-lg bg-orange-500/10 text-orange-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-orange-500/20">Pendente</span>
              <% when 'in_progress' %>
                <span class="px-3 py-1.5 rounded-lg bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-blue-500/20">Em Progresso</span>
              <% when 'completed' %>
                <span class="px-3 py-1.5 rounded-lg bg-green-500/10 text-green-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-green-500/20">Concluído</span>
              <% end %>
            </td>
            <td class="px-8 py-6 text-right">
              <%= link_to "Produzir", admin_content_request_path(request), class: "px-5 py-2 bg-white/5 text-white font-bold text-xs rounded-xl hover:bg-white/10 transition-all border border-white/10" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
