<h1 class="text-2xl font-bold mb-6">Pedidos de Conteudo</h1>

<div class="bg-white rounded-lg shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-gray-500 border-b bg-gray-50">
        <th class="p-3">Cliente</th>
        <th class="p-3">Objetivo</th>
        <th class="p-3">Status</th>
        <th class="p-3">Data</th>
      </tr>
    </thead>
    <tbody>
      <% @content_requests.each do |cr| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3"><%= cr.client.business_name %></td>
          <td class="p-3"><%= cr.objective&.truncate(60) || "—" %></td>
          <td class="p-3"><%= cr.status %></td>
          <td class="p-3 text-gray-500"><%= cr.created_at.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
