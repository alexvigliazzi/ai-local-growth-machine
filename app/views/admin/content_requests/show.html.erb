<div class="mb-12 flex items-center gap-6">
  <%= link_to admin_content_requests_path, class: "p-3 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <div>
    <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Pedido de Conteúdo</h1>
    <p class="text-slate-500 font-medium">Análise do briefing e status da produção.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
  <div class="lg:col-span-2 space-y-10">
    <div class="admin-card p-10">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-4">Briefing do Cliente</h3>
      <div class="space-y-8">
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Objetivo Principal</label>
          <p class="text-xl text-white font-bold tracking-tight leading-relaxed"><%= @content_request.objective %></p>
        </div>
        <div>
          <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Serviços para Destacar</label>
          <p class="text-base text-slate-300 leading-relaxed font-medium"><%= @content_request.services %></p>
        </div>
        <div class="grid grid-cols-2 gap-8">
          <div>
            <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Tom de Voz</label>
            <p class="text-lg text-white font-bold tracking-tight"><%= @content_request.tone&.humanize %></p>
          </div>
          <div>
            <label class="block text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Referências</label>
            <p class="text-lg text-white font-bold tracking-tight"><%= @content_request.references %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Conteúdos Gerados -->
    <div class="admin-card overflow-hidden">
      <div class="p-8 border-b border-white/5 flex justify-between items-center bg-white/5">
        <h3 class="font-bold text-white text-xl tracking-tight">Saídas de Conteúdo (Outputs)</h3>
      </div>
      <div class="divide-y divide-white/5">
        <% if @content_request.content_outputs.any? %>
          <% @content_request.content_outputs.each do |output| %>
            <div class="p-8 flex justify-between items-center hover:bg-white/[0.03] transition-colors group">
              <div>
                <div class="font-bold text-white text-base group-hover:text-blue-400 transition-colors"><%= output.title %></div>
                <div class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1"><%= output.output_type&.humanize %></div>
              </div>
              <div class="flex items-center gap-6">
                <span class="px-3 py-1.5 rounded-lg bg-green-500/10 text-green-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-green-500/20"><%= output.status&.humanize %></span>
                <%= link_to edit_admin_content_output_path(output), class: "text-slate-500 hover:text-white transition-colors" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="p-12 text-center">
            <p class="text-slate-500 italic font-medium">Nenhuma saída gerada ainda.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="space-y-10">
    <div class="admin-card p-8 bg-indigo-600 shadow-2xl shadow-indigo-500/20 border-transparent">
      <h3 class="text-[10px] font-bold text-white/50 uppercase tracking-[0.2em] mb-6">Status da Produção</h3>
      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <% dot_color = { "pending" => "bg-yellow-400 animate-pulse", "in_progress" => "bg-blue-400 animate-pulse", "completed" => "bg-green-400" }.fetch(@content_request.status, "bg-white/20") %>
          <div class="w-3 h-3 rounded-full <%= dot_color %> border-2 border-white/20"></div>
          <span class="text-lg font-bold text-white tracking-tight"><%= @content_request.status&.humanize %></span>
        </div>
        <% if @content_request.status == "completed" %>
          <p class="text-xs text-white/60 font-medium"><%= @content_request.content_outputs.count %> output(s) gerado(s)</p>
        <% end %>
      </div>
      <div class="mt-10 pt-6 border-t border-white/10">
        <%= button_to queue_generation_admin_content_request_path(@content_request),
            method: :post,
            class: "w-full py-4 bg-white text-indigo-600 hover:bg-white/90 text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-3 shadow-xl",
            data: { turbo_confirm: "Enfileirar geração de conteúdo para este pedido?" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Gerar Conteúdo
        <% end %>
      </div>
    </div>

    <div class="admin-card p-8 group">
      <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Cliente</h3>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-blue-500/20 rounded-2xl flex items-center justify-center text-blue-400 font-extrabold text-xl border border-blue-500/20 group-hover:scale-110 transition-transform">
          <%= @content_request.client.business_name[0] %>
        </div>
        <div>
          <div class="text-base font-bold text-white tracking-tight"><%= @content_request.client.business_name %></div>
          <%= link_to "Ver Perfil", admin_client_path(@content_request.client), class: "text-xs text-blue-400 font-bold hover:text-blue-300 transition-colors" %>
        </div>
      </div>
    </div>
  </div>
</div>
