<div class="mb-12 flex items-center gap-6">
  <%= link_to admin_outreach_messages_path, class: "p-3 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  <% end %>
  <div>
    <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Mensagem de Outreach</h1>
    <p class="text-slate-500 font-medium">Visualize e envie a mensagem gerada para o lead.</p>
  </div>
</div>

<div class="max-w-4xl">
  <div class="admin-card overflow-hidden shadow-2xl">
    <div class="p-10 border-b border-white/5 bg-white/[0.02]">
      <div class="flex justify-between items-start">
        <div>
          <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-2">Destinatário</h3>
          <div class="text-2xl font-bold text-white tracking-tight"><%= @outreach_message.lead.business_name %></div>
          <div class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-2">
            <%= @outreach_message.channel&.humanize %> — <%= @outreach_message.created_at.strftime("%d/%m/%Y às %H:%M") %>
          </div>
        </div>
        <span class="px-4 py-2 rounded-xl bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-blue-500/20 shadow-lg shadow-blue-500/10">
          <%= @outreach_message.status&.humanize %>
        </span>
      </div>
    </div>

    <div class="p-10">
      <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6">Conteúdo da Mensagem</h4>
      <div class="bg-white/5 text-slate-300 p-8 rounded-2xl font-mono text-sm leading-relaxed whitespace-pre-wrap border border-white/10 shadow-inner">
        <%= @outreach_message.message %>
      </div>

      <div class="mt-10 pt-10 border-t border-white/5 flex gap-4">
        <% if @outreach_message.lead.whatsapp.present? %>
          <%= link_to "https://wa.me/#{@outreach_message.lead.whatsapp.gsub(/\D/, '')}?text=#{CGI.escape(@outreach_message.message)}", target: "_blank", class: "px-8 py-4 bg-green-500 text-white font-bold rounded-xl shadow-xl shadow-green-500/20 flex items-center gap-3 hover:bg-green-400 transition-all" do %>
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Enviar via WhatsApp
          <% end %>
        <% end %>
        <button class="px-8 py-4 bg-white/5 border border-white/10 text-slate-300 font-bold rounded-xl hover:bg-white/10 transition-all">Marcar como Enviada</button>
      </div>
    </div>
  </div>
</div>
