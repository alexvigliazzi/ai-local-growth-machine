<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-extrabold text-white tracking-tighter leading-tight">Mensagens de Outreach</h1>
  <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest bg-white/5 px-4 py-2 rounded-full border border-white/10">
    Total: <%= @outreach_messages.count %>
  </div>
</div>

<div class="admin-card overflow-hidden shadow-2xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-white/[0.02] text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">
          <th class="px-8 py-5">Lead</th>
          <th class="px-8 py-5">Canal</th>
          <th class="px-8 py-5">Status</th>
          <th class="px-8 py-5 text-right">Data</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% @outreach_messages.each do |msg| %>
          <tr class="hover:bg-white/[0.03] transition-colors group">
            <td class="px-8 py-6">
              <div class="font-bold text-white text-base group-hover:text-blue-400 transition-colors"><%= msg.lead.business_name %></div>
            </td>
            <td class="px-8 py-6">
              <span class="text-[10px] px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-400 font-bold uppercase tracking-widest">
                <%= msg.channel&.humanize %>
              </span>
            </td>
            <td class="px-8 py-6">
              <% case msg.status %>
              <% when 'pending' %>
                <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-500 text-[10px] font-bold uppercase tracking-[0.15em]">Pendente</span>
              <% when 'sent' %>
                <span class="px-3 py-1.5 rounded-lg bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-blue-500/20">Enviada</span>
              <% when 'replied' %>
                <span class="px-3 py-1.5 rounded-lg bg-green-500/10 text-green-400 text-[10px] font-bold uppercase tracking-[0.15em] border border-green-500/20">Respondida</span>
              <% end %>
            </td>
            <td class="px-8 py-6 text-right text-[10px] text-slate-500 font-bold uppercase tabular-nums tracking-widest">
              <%= msg.created_at.strftime("%d/%m/%y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
