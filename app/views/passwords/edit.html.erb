<div class="min-h-[80vh] flex items-center justify-center px-6 reveal">
  <div class="w-full max-w-lg">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tighter">Nova Senha</h1>
      <p class="text-slate-500 font-medium mt-3 text-lg">Crie uma senha forte para sua segurança.</p>
    </div>

    <div class="glass p-10 md:p-12 rounded-[48px] shadow-[0_40px_100px_-20px_oklch(0%_0_0_/_0.1)] border-white/60">
      <% if alert = flash[:alert] %>
        <div class="mb-8 p-4 bg-red-500/10 border border-red-500/20 text-red-600 font-bold rounded-2xl text-sm text-center">
          <%= alert %>
        </div>
      <% end %>

      <%= form_with url: password_path(params[:token]), method: :put do |f| %>
        <div class="space-y-8">
          <div class="group">
            <%= f.label :password, "Nova senha", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-600 transition-colors" %>
            <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "········", maxlength: 72, class: "w-full p-5 rounded-[20px] border border-slate-200 focus:border-blue-500 focus:ring-[6px] focus:ring-blue-500/5 outline-none transition-all font-medium text-slate-900 bg-white/50" %>
          </div>

          <div class="group">
            <%= f.label :password_confirmation, "Confirme a senha", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-600 transition-colors" %>
            <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "········", maxlength: 72, class: "w-full p-5 rounded-[20px] border border-slate-200 focus:border-blue-500 focus:ring-[6px] focus:ring-blue-500/5 outline-none transition-all font-medium text-slate-900 bg-white/50" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Salvar nova senha", class: "w-full py-5 rounded-full btn-primary text-xl font-bold shadow-2xl shadow-blue-500/20 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
