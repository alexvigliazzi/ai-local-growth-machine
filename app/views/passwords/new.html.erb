<div class="min-h-[80vh] flex items-center justify-center px-6 reveal">
  <div class="w-full max-w-lg">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tighter">Esqueceu a senha?</h1>
      <p class="text-slate-500 font-medium mt-3 text-lg">Enviaremos as instruções de recuperação para o seu e-mail.</p>
    </div>

    <div class="glass p-10 md:p-12 rounded-[48px] shadow-[0_40px_100px_-20px_oklch(0%_0_0_/_0.1)] border-white/60">
      <% if alert = flash[:alert] %>
        <div class="mb-8 p-4 bg-red-500/10 border border-red-500/20 text-red-600 font-bold rounded-2xl text-sm text-center">
          <%= alert %>
        </div>
      <% end %>

      <%= form_with url: passwords_path, class: "contents" do |f| %>
        <div class="space-y-8">
          <div class="group">
            <%= f.label :email_address, "Seu e-mail", class: "block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-3 group-focus-within:text-blue-600 transition-colors" %>
            <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "admin@growthmachine.local", value: params[:email_address], class: "w-full p-5 rounded-[20px] border border-slate-200 focus:border-blue-500 focus:ring-[6px] focus:ring-blue-500/5 outline-none transition-all font-medium text-slate-900 bg-white/50" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Enviar instruções", class: "w-full py-5 rounded-full btn-primary text-xl font-bold shadow-2xl shadow-blue-500/20 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-10 text-center">
      <%= link_to "Voltar para o login", new_session_path, class: "text-sm text-slate-400 font-bold hover:text-slate-900 transition-colors" %>
    </div>
  </div>
</div>
