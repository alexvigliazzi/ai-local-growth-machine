<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Growth Machine — Conteúdo Local com IA</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: oklch(99% 0.002 240);
        --surface: oklch(100% 0 0);
        --fg: oklch(18% 0.012 250);
        --muted: oklch(54% 0.012 250);
        --border: oklch(92% 0.005 250);
        --accent: oklch(58% 0.18 255);
        --font-display: 'Inter', -apple-system, system-ui, sans-serif;
      }

      body {
        font-family: 'Inter', sans-serif;
        color: var(--fg);
        background: linear-gradient(180deg, var(--bg), #f0f4f8);
        min-height: 100vh;
      }

      .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border);
      }

      .cinematic-bg {
        position: fixed;
        inset: -10% -5%;
        pointer-events: none;
        z-index: -1;
        opacity: 0.6;
        background:
          radial-gradient(420px 280px at 18% 20%, oklch(85% 0.12 250 / 15%), transparent 70%),
          radial-gradient(500px 360px at 80% 12%, oklch(80% 0.14 280 / 12%), transparent 70%);
      }

      .btn-primary {
        background: var(--accent);
        color: white;
        transition: all 0.2s ease;
      }

      .btn-primary:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px oklch(58% 0.18 255 / 25%);
      }
    </style>
  </head>

  <body class="antialiased">
    <div class="cinematic-bg"></div>

    <nav class="sticky top-0 z-50 glass border-b px-6 py-4">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold tracking-tight">Growth Machine</a>
        <div class="flex gap-6 items-center">
          <a href="#como-funciona" class="text-sm font-medium text-slate-500 hover:text-slate-900">Como funciona</a>
          <a href="/briefing" class="px-4 py-2 rounded-full btn-primary text-sm font-semibold">Quero meu piloto</a>
        </div>
      </div>
    </nav>

    <main>
      <% if notice %>
        <div class="max-w-7xl mx-auto px-6 pt-4">
          <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded-lg text-sm"><%= notice %></div>
        </div>
      <% end %>
      <% if alert %>
        <div class="max-w-7xl mx-auto px-6 pt-4">
          <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg text-sm"><%= alert %></div>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mt-20 border-t py-12 px-6 glass">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
        <div>
          <h3 class="font-bold mb-4">Growth Machine</h3>
          <p class="text-sm text-slate-500">Agencia automatizada de conteudo para negocios locais brasileiros.</p>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Links</h4>
          <ul class="text-sm space-y-2 text-slate-500">
            <li><a href="/" class="hover:text-slate-900">Inicio</a></li>
            <li><a href="/briefing" class="hover:text-slate-900">Briefing</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Contato</h4>
          <p class="text-sm text-slate-500">WhatsApp: (14) 99999-9999</p>
          <p class="text-sm text-slate-500">Instagram: @growthmachine.local</p>
        </div>
      </div>
    </footer>
  </body>
</html>
