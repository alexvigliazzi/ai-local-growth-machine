<!DOCTYPE html>
<html>
  <head>
    <title>Admin — Growth Machine</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-100">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <nav class="w-64 bg-gray-900 text-white p-6 space-y-2">
        <h2 class="text-lg font-bold mb-6">Growth Machine</h2>
        <%= link_to "Dashboard", admin_root_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Leads", admin_leads_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Clientes", admin_clients_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Pedidos", admin_content_requests_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Conteudos", admin_content_outputs_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Outreach", admin_outreach_messages_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <%= link_to "Relatorios", admin_reports_path, class: "block py-2 px-3 rounded hover:bg-gray-800" %>
        <hr class="border-gray-700 my-4">
        <%= link_to "Site", root_path, class: "block py-2 px-3 rounded hover:bg-gray-800 text-gray-400" %>
        <% if authenticated? %>
          <%= button_to "Sair", session_path, method: :delete, class: "block w-full text-left py-2 px-3 rounded hover:bg-gray-800 text-gray-400" %>
        <% end %>
      </nav>

      <!-- Content -->
      <main class="flex-1 p-8">
        <% if notice %>
          <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded-lg mb-6">
            <%= notice %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
