<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Growth Machine — Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --sidebar-bg: oklch(25% 0.02 240);
        --admin-bg: #f8fafc;
        --accent: oklch(58% 0.18 255);
      }
      body { font-family: 'Inter', sans-serif; background: var(--admin-bg); }
      .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; color: #cbd5e1; border-radius: 0.5rem; transition: all 0.15s; text-decoration: none; }
      .sidebar-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
      .sidebar-link.active { color: #fff; background: rgba(255,255,255,0.1); font-weight: 500; }
      .admin-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.75rem; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    </style>
  </head>

  <body class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-64 text-white flex flex-col shrink-0 fixed inset-y-0 z-50" style="background: var(--sidebar-bg)">
      <div class="p-6 border-b border-white/10">
        <h2 class="font-bold text-lg tracking-tight">Growth Machine <span class="text-xs opacity-50 block font-normal">Admin</span></h2>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        <%= link_to admin_root_path, class: "sidebar-link #{controller_name == 'dashboard' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Dashboard
        <% end %>
        <%= link_to admin_leads_path, class: "sidebar-link #{controller_name == 'leads' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Leads
        <% end %>
        <%= link_to admin_clients_path, class: "sidebar-link #{controller_name == 'clients' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          Clientes
        <% end %>
        <%= link_to admin_content_requests_path, class: "sidebar-link #{controller_name == 'content_requests' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Pedidos
        <% end %>
        <%= link_to admin_content_outputs_path, class: "sidebar-link #{controller_name == 'content_outputs' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          Conteudos
        <% end %>
        <%= link_to admin_outreach_messages_path, class: "sidebar-link #{controller_name == 'outreach_messages' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
          Outreach
        <% end %>
        <%= link_to admin_reports_path, class: "sidebar-link #{controller_name == 'reports' ? 'active' : ''}" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Relatorios
        <% end %>

        <div class="pt-6 pb-2 px-4 text-xs font-bold uppercase text-white/30 tracking-widest">Sistema</div>
        <a href="/" target="_blank" class="sidebar-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          Ver Site
        </a>
        <%= button_to session_path, method: :delete, class: "sidebar-link w-full text-left" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          Sair
        <% end %>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-8">
      <% if notice.present? %>
        <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm font-medium"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm font-medium"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
