<div class="min-h-screen bg-gray-50 py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Briefing</h1>
    <p class="text-gray-600 mb-8">Conte sobre seu negocio. Leva menos de 2 minutos.</p>

    <%= form_with url: briefing_path, method: :post, class: "space-y-6 bg-white p-8 rounded-lg shadow-sm" do |f| %>
      <% if @lead.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">
          <ul class="list-disc list-inside">
            <% @lead.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Dados do negocio -->
      <div>
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Sobre o negocio</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nome do negocio *</label>
            <%= f.text_field :business_name, value: @lead.business_name,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "Ex: Moto Center Silva" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Cidade *</label>
            <%= f.text_field :city, value: @lead.city,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "Ex: Campinas - SP" %>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nicho *</label>
        <select name="niche" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">Selecione...</option>
          <option value="oficina_moto">Oficina / Motos</option>
          <option value="estetica_beleza">Estetica / Beleza</option>
          <option value="odontologia">Odontologia</option>
          <option value="outro">Outro</option>
        </select>
      </div>

      <!-- Contato -->
      <div>
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Contato</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Seu nome</label>
            <input type="text" name="contact_name"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                   placeholder="Ex: Carlos Silva">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp *</label>
            <%= f.text_field :whatsapp, value: @lead.whatsapp,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "(19) 99999-9999" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <%= f.text_field :email, value: @lead.email,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "email@exemplo.com" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Instagram do negocio</label>
            <%= f.text_field :instagram_url, value: @lead.instagram_url,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "@motocentersilva" %>
          </div>
        </div>
      </div>

      <!-- Conteudo -->
      <div>
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Sobre o conteudo</h2>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">O que voce quer alcançar com conteudo?</label>
          <textarea name="objective" rows="3"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Ex: Atrair mais clientes para a oficina, mostrar os servicos..."></textarea>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Principais servicos</label>
          <textarea name="services" rows="2"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Ex: Manutencao preventiva, customizacao, troca de oleo..."></textarea>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Tom de voz preferido</label>
          <select name="tone" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="profissional">Profissional</option>
            <option value="descontraido">Descontraido</option>
            <option value="tecnico">Tecnico / Educativo</option>
            <option value="amigavel">Amigavel / Proximo</option>
          </select>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Perfis que voce admira (opcional)</label>
          <textarea name="references" rows="2"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Ex: @motomack, @barbeariavip..."></textarea>
        </div>
      </div>

      <div>
        <button type="submit"
                class="w-full bg-blue-700 text-white font-bold py-3 px-6 rounded-lg hover:bg-blue-600 transition text-lg">
          Enviar briefing &rarr;
        </button>
        <p class="text-gray-500 text-sm text-center mt-2">Voce recebera o conteudo em ate 7 dias.</p>
      </div>
    <% end %>
  </div>
</div>
